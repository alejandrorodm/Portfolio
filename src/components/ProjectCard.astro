---
import type { Project } from '../data/projects';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const title = typeof project.title === 'string' ? project.title : project.title[locale];
---

<article
  class="card js-reveal group flex flex-col p-6 transition-[box-shadow,transform,border-color] duration-200 hover:-translate-y-0.5 hover:border-accent-200 hover:shadow-lift"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold tracking-wide text-accent-600 uppercase">
        {project.overline[locale]}
      </p>
      <h3 class="mt-1.5 text-xl font-bold text-ink">{title}</h3>
    </div>
    <div class="flex shrink-0 items-center gap-1">
      {
        project.repo && (
          <a
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} — ${t('work.viewRepo')}`}
            title={t('work.viewRepo')}
            class="rounded-md p-2 text-zinc-400 transition-colors hover:bg-accent-50 hover:text-accent-700"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-4.5">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.509 11.509 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
        )
      }
      {
        project.pypi && (
          <a
            href={project.pypi}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md px-2 py-1.5 font-mono text-xs text-zinc-400 transition-colors hover:bg-accent-50 hover:text-accent-700"
          >
            PyPI ↗
          </a>
        )
      }
    </div>
  </div>

  <p class="mt-3 flex-1 text-base leading-relaxed text-pretty text-zinc-600">
    {project.description[locale]}
  </p>

  {
    project.award && (
      <p class="mt-3 inline-flex self-start rounded-md bg-amber-50 px-2.5 py-1 text-sm font-medium text-amber-800 ring-1 ring-amber-200/70">
        {project.award[locale]}
      </p>
    )
  }

  {
    project.caseStudy && (
      <details class="group/details mt-4">
        <summary class="cursor-pointer list-none text-xs font-semibold tracking-wide text-accent-600 uppercase transition-colors select-none hover:text-accent-800 [&::-webkit-details-marker]:hidden">
          <span class="inline-block transition-transform group-open/details:rotate-90">▸</span>
          {t('work.caseStudy')}
        </summary>
        <div class="mt-4 space-y-4 border-l-2 border-accent-200 pl-4 text-base leading-relaxed text-zinc-600">
          <div>
            <p class="mb-1 font-semibold text-zinc-900">{t('work.problem')}</p>
            <p>{project.caseStudy.problem[locale]}</p>
          </div>
          <div>
            <p class="mb-1 font-semibold text-zinc-900">{t('work.solution')}</p>
            <p>{project.caseStudy.solution[locale]}</p>
          </div>
          <div>
            <p class="mb-1 font-semibold text-zinc-900">{t('work.results')}</p>
            <p>{project.caseStudy.results[locale]}</p>
          </div>
        </div>
      </details>
    )
  }

  {
    project.gallery && (
      <details class="group/details mt-4">
        <summary class="cursor-pointer list-none text-xs font-semibold tracking-wide text-accent-600 uppercase transition-colors select-none hover:text-accent-800 [&::-webkit-details-marker]:hidden">
          <span class="inline-block transition-transform group-open/details:rotate-90">▸</span>
          {t('work.gallery')}
        </summary>
        <div class="mt-4 flex gap-3 overflow-x-auto pb-2">
          {project.gallery.map((shot) => (
            <img
              src={shot.src}
              alt={shot.alt[locale]}
              loading="lazy"
              class="h-64 w-auto shrink-0 cursor-zoom-in rounded-lg ring-1 ring-zinc-200"
              data-lightbox
            />
          ))}
        </div>
      </details>
    )
  }

  <ul class="mt-5 flex flex-wrap gap-2">
    {
      project.tech.map((tech) => (
        <li class="rounded-md border border-accent-100 bg-accent-50 px-2 py-1 font-mono text-xs font-medium text-accent-900">
          {tech}
        </li>
      ))
    }
  </ul>
</article>
