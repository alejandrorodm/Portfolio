---
import { experience } from '../data/experience';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="trayectoria" class="border-y border-line bg-panel">
  <div class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20 sm:px-10 sm:py-28">
    <h2 class="js-reveal font-display text-4xl font-medium tracking-tight sm:text-5xl">
      {t('exp.title')}
    </h2>

    <div class="mt-12 divide-y divide-line">
      {
        experience.map((job) => (
          <div class="js-reveal grid grid-cols-1 gap-3 py-9 sm:grid-cols-[13rem_minmax(0,1fr)_auto] sm:gap-8">
            <span class="font-mono text-xs tracking-widest text-mist uppercase sm:pt-1.5">
              {job.period[locale]}
            </span>
            <div class="space-y-1.5">
              <h3 class="text-xl font-semibold text-fog">{job.role[locale]}</h3>
              <p class="text-sm text-mist">{job.company}</p>
            </div>
            {job.metric && (
              <div class="sm:text-right">
                <span class="font-display text-3xl font-medium text-ember">{job.metric.value}</span>
                <p class="mt-1 max-w-[14rem] text-xs leading-relaxed text-mist sm:ml-auto">
                  {job.metric.label[locale]}
                </p>
              </div>
            )}
          </div>
        ))
      }

      <div class="js-reveal grid grid-cols-1 gap-3 py-9 sm:grid-cols-[13rem_minmax(0,1fr)_auto] sm:gap-8">
        <span class="font-mono text-xs tracking-widest text-mist uppercase sm:pt-1.5">
          {t('edu.period')}
        </span>
        <div class="space-y-1.5">
          <h3 class="text-xl font-semibold text-fog">{t('edu.degree')}</h3>
          <p class="text-sm text-mist">{t('edu.school')} · {t('edu.honors')}</p>
        </div>
      </div>
    </div>
  </div>
</section>
