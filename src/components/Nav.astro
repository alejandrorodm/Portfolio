---
import { localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/70 bg-night/85 backdrop-blur-md">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 sm:px-10"
    aria-label={locale === 'es' ? 'Principal' : 'Main'}
  >
    <a href={localePath(locale)} class="font-display text-lg font-medium tracking-tight text-fog">
      Alejandro Rodríguez<span class="text-ember">.</span>
    </a>

    <div class="flex items-center gap-7 text-sm font-medium sm:gap-9">
      <a href="#proyectos" class="hidden text-mist transition-colors hover:text-fog sm:block">
        {t('nav.work')}
      </a>
      <a href="#trayectoria" class="hidden text-mist transition-colors hover:text-fog sm:block">
        {t('nav.experience')}
      </a>
      <a
        href="#contacto"
        class="rounded-md border border-ember/50 px-4 py-1.5 text-fog transition-colors hover:bg-ember hover:text-night"
      >
        {t('nav.contact')}
      </a>
      <a
        href={localePath(otherLocale)}
        class="font-mono text-xs tracking-widest text-mist uppercase transition-colors hover:text-fog"
        aria-label={t('lang.switch')}
      >
        {otherLocale}
      </a>
    </div>
  </nav>
</header>
