---
import { localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';

const links = [
  { href: '#about', label: t('nav.about') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#work', label: t('nav.work') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-white/85 backdrop-blur-md transition-[border-color,box-shadow]"
  id="site-header"
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6" aria-label="Main">
    <a
      href={localePath(locale)}
      class="font-mono text-sm font-semibold tracking-tight text-zinc-900"
    >
      alejandro<span class="text-accent-600">rodm</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 sm:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-md px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:bg-accent-50 hover:text-accent-700"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={localePath(otherLocale)}
        class="rounded-md px-3 py-2 font-mono text-xs font-medium text-zinc-500 uppercase transition-colors hover:bg-accent-50 hover:text-accent-700"
        aria-label={t('lang.switch')}
      >
        {otherLocale}
      </a>

      <a
        href="mailto:correo@alejandrorodm.com"
        class="hidden rounded-lg bg-accent-600 px-4 py-2 text-sm font-medium text-white shadow-soft transition-colors hover:bg-accent-700 sm:inline-block"
      >
        {t('contact.email')}
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="rounded-md p-2 text-zinc-500 transition-colors hover:bg-accent-50 hover:text-accent-700 sm:hidden"
      >
        <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-zinc-200 bg-white sm:hidden">
    <ul class="mx-auto max-w-7xl space-y-1 px-6 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:bg-accent-50 hover:text-accent-700"
              data-mobile-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuToggle.setAttribute('aria-expanded', String(open));
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  const header = document.getElementById('site-header');
  const onScroll = () => {
    header?.classList.toggle('border-zinc-200/80', window.scrollY > 24);
    header?.classList.toggle('shadow-soft', window.scrollY > 24);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
