---
import { projects } from '../data/projects';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const selected = projects.filter((p) => p.featured).slice(0, 3);

function title(p: (typeof projects)[number]): string {
  return typeof p.title === 'string' ? p.title : p.title[locale];
}
---

<section id="proyectos" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20 sm:px-10 sm:py-28">
  <div class="js-reveal mb-4 flex items-baseline justify-between gap-6">
    <h2 class="font-display text-4xl font-medium tracking-tight sm:text-5xl">{t('work.title')}</h2>
    <span class="meta hidden sm:block">{t('work.selected')}</span>
  </div>
  <p class="js-reveal max-w-xl text-base text-mist">{t('work.sub')}</p>

  <div class="mt-6 divide-y divide-line border-y border-line">
    {
      selected.map((project, index) => (
        <article class="js-reveal grid grid-cols-1 gap-6 py-12 lg:grid-cols-[5rem_minmax(0,1fr)_16rem] lg:gap-10">
          <span class="font-mono text-sm text-mist pt-1.5">/0{index + 1}</span>

          <div class="space-y-4">
            <p class="meta text-ember">{project.overline[locale]}</p>
            <h3 class="font-display text-3xl font-medium tracking-tight">{title(project)}</h3>
            <p class="max-w-xl leading-relaxed text-mist">{project.description[locale]}</p>

            {project.caseStudy && (
              <details class="group max-w-xl">
                <summary class="cursor-pointer list-none border-b border-mist/40 pb-1 text-sm font-medium text-fog transition-colors hover:border-ember hover:text-ember [&::-webkit-details-marker]:hidden inline-block">
                  {t('work.caseOpen')}
                  <span class="ml-1 inline-block transition-transform group-open:rotate-90">→</span>
                </summary>
                <dl class="mt-6 space-y-5 border-l border-ember/40 pl-5 text-sm leading-relaxed">
                  <div>
                    <dt class="meta mb-1">{t('work.problem')}</dt>
                    <dd class="text-mist">{project.caseStudy.problem[locale]}</dd>
                  </div>
                  <div>
                    <dt class="meta mb-1">{t('work.solution')}</dt>
                    <dd class="text-mist">{project.caseStudy.solution[locale]}</dd>
                  </div>
                  <div>
                    <dt class="meta mb-1">{t('work.results')}</dt>
                    <dd class="text-mist">{project.caseStudy.results[locale]}</dd>
                  </div>
                </dl>
              </details>
            )}
          </div>

          <div class="flex flex-col gap-4 lg:items-end lg:pt-1.5 lg:text-right">
            <span class="font-mono text-xs leading-loose text-mist">{project.tech.join(' · ')}</span>
            {project.repo && (
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-fog transition-colors hover:text-ember"
              >
                {t('work.viewRepo')} ↗
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="js-reveal mt-10">
    <a
      href="https://github.com/alejandrorodm"
      target="_blank"
      rel="noopener noreferrer"
      class="border-b border-mist/50 pb-1 text-base font-medium text-fog transition-colors hover:border-ember hover:text-ember"
    >
      {t('work.allGithub')} ↗
    </a>
  </div>
</section>
