---
interface Props {
  id?: string;
  title: string;
  sub?: string;
}

const { title, sub } = Astro.props;
---

<div class="js-reveal mb-8 max-w-3xl sm:mb-10">
  <div class="flex items-center gap-3">
    <span
      class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600 ring-1 ring-accent-100"
      aria-hidden="true"
    >
      <slot name="icon" />
    </span>
    <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">{title}</h2>
  </div>
  {sub && <p class="mt-3 leading-relaxed text-zinc-600 sm:text-lg">{sub}</p>}
</div>
