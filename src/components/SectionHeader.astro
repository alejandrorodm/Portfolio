---
interface Props {
  id?: string;
  overline: string;
  title: string;
  sub?: string;
}

const { overline, title, sub } = Astro.props;
---

<div class="js-reveal mb-12 max-w-3xl sm:mb-16">
  <p class="mb-2 font-mono text-xs tracking-widest text-accent-600 uppercase sm:text-sm dark:text-accent-400">
    {overline}
  </p>
  <h2 class="text-3xl font-semibold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50">{title}</h2>
  {sub && <p class="mt-3 leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">{sub}</p>}
</div>
