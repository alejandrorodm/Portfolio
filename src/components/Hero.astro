---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 px-6 pt-32 pb-20 sm:px-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-20 lg:pt-44 lg:pb-28">
  <div class="js-reveal space-y-8">
    <p class="meta">
      <span class="mr-2 inline-block size-2 rounded-full bg-ember align-middle"></span>
      {t('hero.role')}
    </p>

    <h1 class="font-display text-5xl leading-[1.06] font-medium tracking-tight text-balance sm:text-6xl lg:text-7xl">
      {
        locale === 'es' ? (
          <>
            Sistemas de IA que <em class="font-normal text-ember italic">funcionan</em> en producción.
          </>
        ) : (
          <>
            AI systems that actually <em class="font-normal text-ember italic">work</em> in production.
          </>
        )
      }
    </h1>

    <p class="max-w-xl text-lg leading-relaxed text-mist">{t('hero.sub')}</p>

    <div class="flex flex-wrap items-center gap-6 pt-2">
      <a
        href="#proyectos"
        class="rounded-md bg-ember px-7 py-3.5 text-base font-semibold text-night transition-transform duration-200 hover:-translate-y-0.5"
      >
        {t('hero.cta.work')}
      </a>
      <a
        href="mailto:correo@alejandrorodm.com"
        class="border-b border-mist/50 pb-1 text-base font-medium text-fog transition-colors hover:border-ember hover:text-ember"
      >
        {t('hero.cta.contact')}
      </a>
    </div>
  </div>

  <figure class="js-reveal relative mx-auto w-full max-w-xs lg:max-w-none">
    <div class="absolute -top-3 -right-3 h-full w-full rounded-2xl border border-ember/30" aria-hidden="true"></div>
    <img
      src="/foto-perfil.jpg"
      alt="Alejandro Rodríguez Moreno"
      width="900"
      height="1200"
      class="relative aspect-[3/4] w-full rounded-2xl border border-line object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <figcaption class="mt-4 flex items-center justify-between font-mono text-xs tracking-widest text-mist uppercase">
      <span>{t('hero.photoCaption')}</span>
      <span>36.72°N — 4.42°O</span>
    </figcaption>
  </figure>
</section>
