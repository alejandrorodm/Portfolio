---
import { coreStack, skillGroups } from '../data/skills';
import { languages } from '../data/certifications';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
  <!-- Contacto -->
  <div class="card js-reveal p-6">
    <h3 class="mb-4 text-xs font-semibold tracking-widest text-zinc-500 uppercase">
      {t('nav.contact')}
    </h3>
    <ul class="space-y-3 text-sm">
      <li>
        <a
          href="mailto:correo@alejandrorodm.com"
          class="group flex items-center gap-2.5 font-medium text-zinc-700 transition-colors hover:text-accent-700"
        >
          <svg class="size-4 shrink-0 text-accent-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-10 6L2 7"></path>
          </svg>
          <span class="truncate group-hover:underline">correo@alejandrorodm.com</span>
        </a>
      </li>
      <li>
        <a
          href="https://github.com/alejandrorodm"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-2.5 font-medium text-zinc-700 transition-colors hover:text-accent-700"
        >
          <svg class="size-4 shrink-0 text-accent-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.509 11.509 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"></path>
          </svg>
          <span class="group-hover:underline">github.com/alejandrorodm</span>
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/in/alejandrorodmoreno/"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-2.5 font-medium text-zinc-700 transition-colors hover:text-accent-700"
        >
          <svg class="size-4 shrink-0 text-accent-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
          </svg>
          <span class="group-hover:underline">in/alejandrorodmoreno</span>
        </a>
      </li>
      <li class="flex items-center gap-2.5 text-zinc-600">
        <svg class="size-4 shrink-0 text-accent-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {t('hero.location')}
      </li>
    </ul>
  </div>

  <!-- Habilidades -->
  <div class="card js-reveal p-6">
    <h3 class="mb-4 flex items-center gap-2 text-xs font-semibold tracking-widest text-zinc-500 uppercase">
      {t('skills.title')}
    </h3>

    <p class="mb-2.5 text-xs font-medium text-accent-700">{t('about.stack')}</p>
    <ul class="flex flex-wrap gap-1.5">
      {
        coreStack.map((tech) => (
          <li class="flex items-center gap-1.5 rounded-md border border-accent-100 bg-accent-50 px-2.5 py-1.5 text-xs font-semibold text-zinc-800">
            {tech.icon && <img src={tech.icon} alt="" width="14" height="14" loading="lazy" class="size-3.5" />}
            {tech.name}
          </li>
        ))
      }
    </ul>

    {
      skillGroups.map((group) => (
        <div class="mt-5">
          <p class="mb-2.5 text-xs font-medium text-accent-700">{group.label[locale]}</p>
          <ul class="flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li class="flex items-center gap-1.5 rounded-md bg-zinc-100 px-2 py-1 text-xs font-medium text-zinc-700">
                {item.icon && <img src={item.icon} alt="" width="14" height="14" loading="lazy" class="size-3.5" />}
                {item.name}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <!-- Educación -->
  <div class="card js-reveal p-6">
    <h3 class="mb-4 text-xs font-semibold tracking-widest text-zinc-500 uppercase">
      {t('edu.title')}
    </h3>
    <div class="flex gap-3">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600 ring-1 ring-accent-100" aria-hidden="true">
        <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 10 12 5 2 10l10 5 10-5Z"></path>
          <path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"></path>
          <path d="M22 10v6"></path>
        </svg>
      </span>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-zinc-900">{t('edu.degree')}</p>
        <p class="mt-0.5 text-sm text-zinc-600">{t('edu.school')}</p>
        <p class="mt-1 font-mono text-xs text-zinc-500">{t('edu.period')}</p>
        <p class="mt-2 inline-block rounded-md bg-accent-50 px-2 py-1 text-xs font-semibold text-accent-700">
          {t('edu.honors')}
        </p>
      </div>
    </div>
  </div>

  <!-- Idiomas -->
  <div class="card js-reveal p-6">
    <h3 class="mb-4 text-xs font-semibold tracking-widest text-zinc-500 uppercase">
      {t('certs.languages')}
    </h3>
    <ul class="space-y-2.5">
      {
        languages.map((lang) => (
          <li class="flex items-center justify-between gap-2 text-sm">
            <span class="font-medium text-zinc-800">{lang.name[locale]}</span>
            <span class="rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-xs text-zinc-600">
              {lang.level[locale]}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
