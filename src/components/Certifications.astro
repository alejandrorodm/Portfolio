---
import SectionHeader from './SectionHeader.astro';
import { certCategories, featuredCert, languages } from '../data/certifications';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="certifications" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-20 sm:py-24">
  <SectionHeader overline="04" title={t('certs.title')} />

  <div
    class="js-reveal flex flex-col gap-5 rounded-xl border border-zinc-200 bg-zinc-50 p-6 sm:flex-row sm:items-center sm:gap-8 dark:border-zinc-800 dark:bg-zinc-900/50"
  >
    <img src={featuredCert.logo} alt="Databricks" width="56" height="56" class="size-14 shrink-0" loading="lazy" />
    <div>
      <p class="font-mono text-xs tracking-widest text-accent-600 uppercase dark:text-accent-400">
        {t('certs.featured')} · {featuredCert.year}
      </p>
      <h3 class="mt-1 text-lg font-semibold text-zinc-900 dark:text-zinc-50">{featuredCert.name}</h3>
      <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
        {featuredCert.description[locale]}
      </p>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      certCategories.map((category) => (
        <div class="js-reveal">
          <h3 class="mb-3 font-mono text-xs tracking-widest text-zinc-500 uppercase">{category.label[locale]}</h3>
          <ul class="space-y-2.5">
            {category.items.map((cert) => (
              <li class="text-sm leading-snug text-zinc-700 dark:text-zinc-300">
                {cert.name}
                {cert.tag && (
                  <span class="ml-1.5 rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[11px] text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">
                    {cert.tag}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="js-reveal">
      <h3 class="mb-3 font-mono text-xs tracking-widest text-zinc-500 uppercase">{t('certs.languages')}</h3>
      <ul class="space-y-2.5">
        {
          languages.map((lang) => (
            <li class="text-sm leading-snug text-zinc-700 dark:text-zinc-300">
              {lang.name[locale]}
              <span class="ml-1.5 rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[11px] text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">
                {lang.level[locale]}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
